# ============================================================================
# RAGOps configuration. Copy to `.env` (repo root, used by docker compose)
# or `backend/.env` (local development) and fill in the values.
# Real environment variables always override this file.
# ============================================================================

# --- Required ------------------------------------------------------------------
# Long random string. Signs logins and encrypts stored database passwords.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never change it once databases are connected (their passwords become unreadable).
SECRET_KEY=change-me

# First admin account, created on startup if it doesn't exist.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too

# --- LLM providers (free tiers; set at least one) -------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Database ---------------------------------------------------------------------
# Option A (Oracle VM / docker compose): leave DATABASE_URL unset and the bundled
# Postgres+pgvector container is used with this password.
POSTGRES_PASSWORD=change-me-db
# Option B: an external Postgres with pgvector (e.g. Neon). Overrides option A.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Frontend / CORS -----------------------------------------------------------------
# Public URL of the backend, used when building the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Extra allowed browser origins (comma separated), e.g. your Vercel/Cloudflare domain.
# *.vercel.app, *.pages.dev and *.workers.dev are allowed by default.
CORS_ORIGINS=

# --- Public HTTPS for the backend --------------------------------------------------
# Option 1 (no domain needed): free DuckDNS name + Caddy   (docker compose --profile https)
API_DOMAIN=
# Option 2 (you own a domain on Cloudflare): Cloudflare Tunnel (docker compose --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Local models (open-source, run on the server) ----------------------------------
# onnx (default): no PyTorch, fits a 512 MB free host.  torch: bge-reranker-base, needs ~1.5 GB+.
MODEL_BACKEND=onnx
# MODEL_CACHE_DIR=./.models            # where models are stored (downloaded at build time)
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # "none" disables reranking (saves ~80 MB RAM)
# RERANK_MAX_CANDIDATES=20             # cross-encoder work per question (CPU-bound)
# MODEL_CONCURRENCY=1                  # simultaneous local inferences
# ONNX_MEMORY_ARENA=false              # true = ~15% faster inference, ~2x model memory
# WORKER_IDLE_POLL_SECONDS=3600        # rare polling lets Neon scale to zero

# --- Optional tuning ------------------------------------------------------------------
# ENVIRONMENT=production
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# ALLOW_SELF_REGISTRATION=true        # false = only admins create accounts
# MAX_UPLOAD_MB=25
# MAX_FILES_PER_UPLOAD=20
# WORKER_THREADS=2                    # parallel document-processing workers
# RATE_LIMIT_CHAT_PER_MIN=30
# PRELOAD_MODELS=true                 # set false on tiny (512 MB) hosts
# INSTALL_DOCLING=false               # true = layout-aware PDF parsing (bigger image)
# BAKE_EMBEDDING_MODELS=all-MiniLM-L6-v2,BAAI/bge-small-en-v1.5
# DB_CONNECTOR_ROW_LIMIT=200
# DB_CONNECTOR_TIMEOUT_MS=15000

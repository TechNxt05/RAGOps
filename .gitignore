# ==========================================
# RAGOps Master .gitignore
# ==========================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.log
*.sqlite3
*.db
*.db-journal
postgres_data/
ragops.db*
backend/ragops.db*

# Node / Next.js
node_modules/
.next/
dist/
out/
build/
coverage/
*.tsbuildinfo

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# FAISS Vector Indices & Binary Cache Stores
faiss_index/
backend/faiss_index/
backend/.models/
*.faiss
*.pkl

# Benchmark Reports & Intermediate State Files
benchmark_report*.json
*.partial.json
backend/benchmark_report*.json
*benchmark_*out*.txt
backend/diff_output.txt
backend/data/

# Scratch, Debug & Transient Scripts
Results.txt
logs.txt
Comparison.txt
scratch/
# Ad-hoc scripts at the top of backend/ (real tests live in backend/tests/)
/backend/audit_*.py
/backend/scratch_*.py
/backend/check_*.py
/backend/inspect_*.py
/backend/debug_*.py
.pytest_cache/
backend/test_*.py
backend/inspect_*.py
backend/debug_*.py
backend/compute_*.py
backend/paired_*.py
backend/rebuild_*.py
backend/run_full_benchmark.py
backend/run_llama_benchmark.py
backend/run_qwen_benchmark.py
